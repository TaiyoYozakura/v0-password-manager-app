{
  "expo": {
    "name": "Vault",
    "slug": "vault-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "vault",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0b1220"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.example.vault",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Use Face ID to unlock your vault."
      }
    },
    "android": {
      "package": "com.example.vault",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0b1220"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Use Face ID to unlock your vault."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
