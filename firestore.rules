rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: require the required encrypted fields to exist on writes
    function hasPasswordFields() {
      return request.resource.data.keys().hasAll([
        'encryptedPassword',
        'encryptedUsername',
        'encryptedEmail',
        'encryptedNotes',
        'integrityHash',
        'tag',
        'siteUrl',
        'siteName',
        'createdAt',
        'updatedAt'
      ]);
    }

    function hasPinFields() {
      return request.resource.data.keys().hasAll([
        'encryptedPin',
        'encryptedNotes',
        'integrityHash',
        'label',
        'category',
        'createdAt',
        'updatedAt'
      ]);
    }

    match /users/{userId}/passwords/{docId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
                            && request.auth.uid == userId
                            && hasPasswordFields();
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/pins/{docId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
                            && request.auth.uid == userId
                            && hasPinFields();
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/profile/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
